# k8labs reproducible kernel config fragment
# Merged onto the pinned upstream linux-next source before building.
# Every option here is required by the linux-sched cgroup-v2 quota campaign:
# sched_ext schedules, BPF/BTF loads the schedulers, and cgroup v2 CFS
# bandwidth is what the CPU quota treatments exercise.
CONFIG_SCHED_CLASS_EXT=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_DEBUG_INFO_BTF=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_SCHED=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_CGROUP_CPUACCT=y
# The kernel/sched/debug.c cgroup_mode switch (up, smp, concur, max, tasks) is
# compiled only under CONFIG_FAIR_GROUP_SCHED and lives in debugfs under
# /sys/kernel/debug/sched/cgroup_mode, so both must be enabled.
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_DEBUG_FS=y
CONFIG_DEBUG_FS_ALLOW_ALL=y
# /sys/kernel/debug/sched/preempt is registered under PREEMPT_DYNAMIC; the
# preempt=lazy and preempt=full boot parameters select the mode at boot.
CONFIG_PREEMPT_DYNAMIC=y
CONFIG_PREEMPT_LAZY=y
CONFIG_EXPERT=y
# PREEMPT_RT is deliberately left disabled: it replaces the scheduler locking
# and is not compatible with sched_ext in the same image (see research/cpu-limits
# phase 7.6 for the scope note).
# Secure Boot needs a signed EFI-stub kernel image.
CONFIG_EFI_STUB=y
# Module signatures so the signed release can be verified.
CONFIG_MODULE_SIG=y
CONFIG_MODULE_SIG_ALL=y
# Fixed module-signing key: a generated key per build makes the module packages
# and the embedded certificate differ between otherwise identical builds.
# CONFIG_MODULE_SIG_FORCE is intentionally unset, so this key only has to be
# stable, not secret.
CONFIG_MODULE_SIG_KEY="certs/k8labs-module-signing.pem"
