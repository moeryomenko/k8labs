# Build artifacts (base image, ISOs) — reproducible via Packer
build/
build/base/
*.qcow2
*.iso

# Python virtual environment — created by uv sync
.venv/

# Local HostAgent configuration and generated mTLS material
host-agent/

# Extension release artifacts — squashfs images and directory-mode copies (reproducible)
extensions/release/*.raw
extensions/release/*/
*.raw

# Download temporary directories
sysext/*/.download.tmp/

# Sysext binary files — downloaded at build time, never committed
sysext/cri-o/usr/bin/*
sysext/crun/usr/bin/crun
sysext/kubelet/usr/bin/kubelet
sysext/cni/usr/lib/cni/*
sysext/etcd/usr/bin/*
sysext/kubernetes-cp/usr/bin/*
sysext/perfetto/usr/bin/*

# Generated kubeconfig for legacy cluster-ops targets
kubeconfig

# Temporal files — logs, stamps, generated output
*.log
crash.log
crash.*.log

perfetto-plots
perfetto-analysis

# Research experiment data — written under a host-owned data root
# (${K8LABS_RESEARCH_DATA_ROOT:-build}/research/...); these rules are a backstop
# for anything produced under research/ by mistake.
research/linux-sched/experiments/data/
research/linux-sched/analysis/output/
research/kube-sched/experiments/data/
research/kube-sched/analysis/output/

# Local scratch bakes reference throwaway keys outside the repository.
packer/vars.scratch.pkrvars.hcl
