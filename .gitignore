# Build artifacts (base image, ISOs) — reproducible via Packer
build/
build/base/
*.qcow2
*.iso

# Python virtual environment — created by uv sync
.venv/

# Extension release artifacts — squashfs images and directory-mode copies (reproducible)
extensions/release/*.raw
extensions/release/*/
*.raw

# Download temporary directories
sysext/*/.download.tmp/

# Sysext binary files — downloaded at build time, never committed
sysext/cri-o/usr/bin/*
sysext/crun/usr/bin/crun
sysext/kubelet/usr/bin/kubelet
sysext/cni/usr/lib/cni/*
sysext/etcd/usr/bin/*
sysext/kubernetes-cp/usr/bin/*
sysext/perfetto/usr/bin/*

# Generated TLS certificates, kubeconfigs, and cluster admin config
/certs/*
!/certs/.gitkeep
kubeconfig

# Local .terraform directories and state
.terraform/
*.tfstate
*.tfstate.*
.terraform.tfstate.lock.info

# Temporal files — logs, stamps, generated output
*.log
crash.log
crash.*.log

# .tfvars files contain sensitive data — never commit
*.tfvars
*.tfvars.json

# Parser test fixtures are intentionally committed (canonical parser inputs)
!tests/fixtures/*.tfvars

# Research bats fixtures are intentionally committed (derivation test inputs)
!research/cpu-sched/experiments/tests/fixtures/*.tfvars

# Override files are local-only
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration files (local to each developer)
.terraformrc
terraform.rc

# Generated cloud-init disk images — created at build time
terraform/cloud-init/out/

perfetto-plots
perfetto-analysis
research/cpu-sched/analysis/output/

# Go compiled binaries — built from source
**/api-server/api-server
**/db-simulator/db-simulator
**/api-server/bin/
**/db-simulator/bin/
**/cpu-burner/cpu-burner

# Experiment data directories — generated, not committed
research/cpu-sched/experiments/data/
research/cpu-sched/analysis/output/tunable-sweep-results/
research/cpu-sched/analysis/output/cpu-manager-comparison/
research/cpu-sched/analysis/output/eevdf-metrics-stress/
research/cpu-sched/analysis/output/throttling-stress/
/tmp/tunable-sweep/
