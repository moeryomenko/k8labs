#!/usr/bin/env python3
"""Fetch a workload-cluster kubeconfig from a Secret manifest.

Usage:
    fetch-kubeconfig <path-to-secret-manifest.yaml>

Reads the Secret manifest at the given path, decodes its ``value`` key
(base64 in ``data`` or plaintext in ``stringData``), validates that the
decoded payload parses as a v1 ``Config`` kubeconfig document, and writes the
decoded kubeconfig YAML verbatim to stdout with exit status 0.

This serves the ``<cluster>-kubeconfig`` Secret (data key ``value``) that the
HypervisorControlPlane controller publishes on the management cluster after
the workload API server passes its healthz gate.

Failure modes exit non-zero with a diagnostic on stderr:

- missing or unreadable manifest file, or unparseable YAML
- no ``value`` key under ``data``/``stringData`` (or ambiguous: both)
- invalid base64 in ``data.value``
- empty decoded payload
- decoded document whose kind is not ``Config`` or apiVersion is not ``v1``
"""

from __future__ import annotations

import base64
import sys
from pathlib import Path

import yaml


def fail(message: str) -> None:
    """Print a diagnostic to stderr and exit non-zero."""
    print(f"fetch-kubeconfig: {message}", file=sys.stderr)
    raise SystemExit(1)


def main(argv: list[str]) -> int:
    """Decode the kubeconfig Secret and print it, or diagnose and fail."""
    if len(argv) != 2:
        fail(f"usage: {Path(argv[0]).name} <secret-manifest.yaml>")
    path = Path(argv[1])
    try:
        text = path.read_text(encoding="utf-8")
    except OSError as exc:
        fail(f"cannot read {path}: {exc}")
    try:
        doc = yaml.safe_load(text)
    except yaml.YAMLError as exc:
        fail(f"{path}: does not parse as YAML: {exc}")
    if not isinstance(doc, dict):
        fail(f"{path}: does not parse to a mapping")
    data = doc.get("data")
    string_data = doc.get("stringData")
    has_data = isinstance(data, dict) and "value" in data
    has_plain = isinstance(string_data, dict) and "value" in string_data
    if has_data and has_plain:
        fail(f"{path}: 'value' present in both data and stringData")
    if has_data:
        encoded = data["value"]
        if not isinstance(encoded, str):
            fail(f"{path}: data['value'] is not a string")
        try:
            payload = base64.b64decode(encoded, validate=True)
        except ValueError as exc:
            # binascii.Error (invalid alphabet/padding) subclasses ValueError.
            fail(f"{path}: data['value'] is not valid base64: {exc}")
    elif has_plain:
        plain = string_data["value"]
        if not isinstance(plain, str):
            fail(f"{path}: stringData['value'] is not a string")
        payload = plain.encode("utf-8")
    else:
        fail(f"{path}: Secret carries no 'value' key under data/stringData")
    if not payload.strip():
        fail(f"{path}: decoded 'value' is empty")
    try:
        config = yaml.safe_load(payload.decode("utf-8"))
    except (UnicodeDecodeError, yaml.YAMLError) as exc:
        fail(f"{path}: decoded 'value' does not parse as YAML: {exc}")
    if not isinstance(config, dict):
        fail(f"{path}: decoded 'value' is not a YAML mapping")
    kind = config.get("kind")
    api_version = config.get("apiVersion")
    if kind != "Config" or api_version != "v1":
        fail(
            f"{path}: decoded payload is apiVersion={api_version!r} "
            f"kind={kind!r}, want apiVersion=v1 kind=Config"
        )
    # The provider writes the kubeconfig server as https://host.containers.internal:<port>
    # so the management-plane controllers (capishim pod) can reach the workload
    # apiserver; from the lab host that name does not resolve, so rewrite it to
    # the loopback address the kubeconfig was historically published at.
    payload_text = payload.decode("utf-8")
    payload_text = payload_text.replace(
        "https://host.containers.internal:",
        "https://127.0.0.1:",
    )
    sys.stdout.write(payload_text)
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
