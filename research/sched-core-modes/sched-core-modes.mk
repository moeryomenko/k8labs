# k8labs sched-core-modes research series Makefile
#
# Controlled cgroup-v2 experiment for the five `cgroup_mode` values:
# up, smp, concur, max, tasks. The measured target is a lab worker reached
# through the control-plane VM; results are pulled back to the host data root.
# See README.md for the protocol and the interpretation limits.

SHELL := /bin/bash
.ONESHELL:
.SHELLFLAGS := -eu -o pipefail -c

PROJECT_ROOT ?= $(shell git rev-parse --show-toplevel 2>/dev/null || pwd)
SCHED_CORE_MODES_DIR := $(abspath $(dir $(lastword $(MAKEFILE_LIST))))/
SCHED_CORE_MODES_EXPERIMENTS := $(SCHED_CORE_MODES_DIR)experiments
SCHED_CORE_MODES_TESTS := $(SCHED_CORE_MODES_DIR)tests
SCHED_CORE_MODES_RUNNER := $(SCHED_CORE_MODES_EXPERIMENTS)/run-matrix.sh
SCHED_CORE_MODES_ANALYZER := $(SCHED_CORE_MODES_EXPERIMENTS)/analyze.py
SCHED_CORE_MODES_DATA_ROOT ?= $(PROJECT_ROOT)/build/research/sched-core-modes
SCHED_CORE_MODES_RUN_DIR ?= $(SCHED_CORE_MODES_DATA_ROOT)/latest
SCHED_CORE_MODES_ANALYSIS_DIR ?= $(SCHED_CORE_MODES_RUN_DIR)/analysis
PROFILE ?= pilot

.PHONY: sched-core-modes-setup
sched-core-modes-setup: ## Verify worker SSH, kernel, cgroup v2, debugfs and tools
	$(SCHED_CORE_MODES_RUNNER) --setup

.PHONY: sched-core-modes-plan
sched-core-modes-plan: ## Print the seeded plan without changing the worker mode
	$(SCHED_CORE_MODES_RUNNER) --plan --profile $(PROFILE)

.PHONY: sched-core-modes-pilot
sched-core-modes-pilot: ## Run a 1-rep, 3-second pilot matrix
	$(SCHED_CORE_MODES_RUNNER) --profile pilot

.PHONY: sched-core-modes-run
sched-core-modes-run: ## Run the full 3-rep, 8-second matrix
	$(SCHED_CORE_MODES_RUNNER) --profile full

.PHONY: sched-core-modes-analyze
sched-core-modes-analyze: ## Analyze the latest matrix into shares/metrics/summary
	@test -f "$(SCHED_CORE_MODES_RUN_DIR)/matrix.jsonl" || { \
		echo "ERROR: no matrix.jsonl under $(SCHED_CORE_MODES_RUN_DIR); run the pilot or full matrix first" >&2; \
		exit 1; \
	}
	python3 $(SCHED_CORE_MODES_ANALYZER) \
		--matrix "$(SCHED_CORE_MODES_RUN_DIR)/matrix.jsonl" \
		--meta "$(SCHED_CORE_MODES_RUN_DIR)/meta.json" \
		--output-dir "$(SCHED_CORE_MODES_ANALYSIS_DIR)"
	@echo "  Summary: $(SCHED_CORE_MODES_ANALYSIS_DIR)/summary.md"

.PHONY: sched-core-modes-report
sched-core-modes-report: sched-core-modes-analyze ## Copy the latest analysis to RESEARCH/RESULTS.md
	@test -f "$(SCHED_CORE_MODES_ANALYSIS_DIR)/summary.md" || { \
		echo "ERROR: analysis did not produce summary.md" >&2; \
		exit 1; \
	}
	{ \
		echo "<!-- generated by make sched-core-modes-report -->"; \
		cat "$(SCHED_CORE_MODES_ANALYSIS_DIR)/summary.md"; \
	} > "$(SCHED_CORE_MODES_DIR)RESULTS.md"
	@echo "  Report: $(SCHED_CORE_MODES_DIR)RESULTS.md"

.PHONY: sched-core-modes-test
sched-core-modes-test: ## Run offline tests and linters for the series
	cd "$(PROJECT_ROOT)" && uv run pytest -q "research/sched-core-modes/tests"
	python3 -m py_compile \
		"$(SCHED_CORE_MODES_EXPERIMENTS)/scenarios.py" \
		"$(SCHED_CORE_MODES_EXPERIMENTS)/run_matrix.py" \
		"$(SCHED_CORE_MODES_EXPERIMENTS)/analyze.py"
	bash -n "$(SCHED_CORE_MODES_RUNNER)"
	@if command -v shellcheck >/dev/null 2>&1; then \
		shellcheck "$(SCHED_CORE_MODES_RUNNER)"; \
	else \
		echo "shellcheck not installed; skipped"; \
	fi

.PHONY: sched-core-modes-k8s
sched-core-modes-k8s: ## Run the optional Kubernetes QoS sanity jobs (NODE=<worker>)
	@test -n "$(NODE)" || { \
		echo "ERROR: set NODE=<worker node name> (for example NODE=k8labs-md-custom-...)" >&2; \
		exit 1; \
	}
	sed "s/__NODE_NAME__/$(NODE)/g" \
		"$(SCHED_CORE_MODES_DIR)workloads/k8s-qos.yaml" \
		| kubectl --kubeconfig "$(PROJECT_ROOT)/build/kubeconfig" apply -f -
	kubectl --kubeconfig "$(PROJECT_ROOT)/build/kubeconfig" -n sched-core-modes \
		wait --for=condition=complete job -l sched-core-modes/run=qos --timeout=180s
	@for job in qos-guaranteed qos-burstable qos-besteffort qos-quota; do \
		echo "=== $$job ==="; \
		kubectl --kubeconfig "$(PROJECT_ROOT)/build/kubeconfig" -n sched-core-modes \
			logs "job/$$job" --tail=20 || true; \
	done

.PHONY: sched-core-modes-k8s-clean
sched-core-modes-k8s-clean: ## Remove the optional Kubernetes QoS namespace
	kubectl --kubeconfig "$(PROJECT_ROOT)/build/kubeconfig" delete namespace \
		sched-core-modes --ignore-not-found

.PHONY: sched-core-modes-data-usage
sched-core-modes-data-usage: ## Show the data root size
	@du -sh "$(SCHED_CORE_MODES_DATA_ROOT)" 2>/dev/null || echo "no data root yet"

.PHONY: sched-core-modes-help
sched-core-modes-help: ## Show this series' targets
	@echo "sched-core-modes targets:"
	@grep -E '^sched-core-modes-[a-z0-9-]+:.*?## ' $(lastword $(MAKEFILE_LIST)) \
		| sed 's/:.*## /: /'
