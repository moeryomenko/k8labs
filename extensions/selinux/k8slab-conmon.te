# k8slab-conmon: comprehensive init_t permissions for the k8s container stack
# (validated in the E2E replay).
#
# The lab runs the k8s services (crio, kubelet, etcd, kube-apiserver,
# kube-controller-manager, kube-scheduler) from the base init_t domain: the
# merged sysext binaries are unlabeled_t (k8slab-merge covers their exec), and
# no container-selinux type_transition from init_t is installed, so every
# service and every pod process stays in init_t. Under SELinux Enforcing the
# An E2E run observed a large denial catalog that
# blocked service starts, image pulls and pod creation:
#
#   init_t -> conmon_exec_t:file execute            (crio 203/EXEC: dnf-baked
#                                                    conmon is conmon_exec_t,
#                                                    only container_runtime_t
#                                                    may exec it by default)
#   init_t -> unreserved_port_t:tcp_socket name_connect  (apiserver->etcd 2379)
#   init_t -> http_port_t:tcp_socket name_connect        (crio registry:443)
#   init_t -> kmsg_device_t:chr_file open/read           (kubelet /dev/kmsg)
#   init_t -> kernel_t:system syslog_read                (kubelet)
#   init_t -> container_file_t:sock_file/file/dir create/write
#                                                    (kubelet device-plugins
#                                                     kubelet.sock)
#   init_t -> iptables_var_run_t:file create         (/run/xtables.lock)
#   init_t -> tmpfs_t/container_file_t:filesystem relabelfrom/relabelto
#                                                    (crio shm tmpfs)
#   init_t -> devpts_t:filesystem relabel            (crun devpts)
#   init_t -> fs_t:filesystem relabelfrom/relabelto  (crio overlay storage mount)
#   init_t -> ifconfig_var_run_t:file create         (crio pinns ns files)
#   init_t -> container_runtime_tmpfs_t:dir rmdir    (sandbox shm cleanup)
#   init_t -> fusefs_t:file/lnk_file/dir + fusermount_exec_t:file execute
#                                                    (fuse-overlayfs rootfs
#                                                     over btrfs)
#   init_t -> process setpgid                        (crio/conmon)
#   init_t -> container_t:key create/search/read/... (crun container keyring)
#   init_t -> container_ro_file_t:file exec + entrypoint + process transition
#                                                    (crun starts the sandbox/
#                                                     container binary)
#   init_t -> container_var_run_t:fifo_file/file     (conmon ctl fifo,
#                                                     storage locks)
#
# A node-local diagnostic module covering exactly these rules made
# crio/kubelet/etcd/apiserver/cm/scheduler and pods run under Enforcing; this
# module ships that coverage in the base image. Scoped to the catalog classes;
# no broader domain grant is made.

policy_module(k8slab-conmon, 1.0)

require {
    type init_t;
    type conmon_exec_t;
    type unreserved_port_t;
    type http_port_t;
    type kubernetes_port_t;
    type NetworkManager_t;
    type kmsg_device_t;
    type kernel_t;
    type container_file_t;
    type container_var_run_t;
    type var_run_t;
    type init_var_run_t;
    type container_runtime_tmpfs_t;
    type iptables_var_run_t;
    type ifconfig_var_run_t;
    type tmpfs_t;
    type devpts_t;
    type fs_t;
    type container_t;
    type container_ro_file_t;
    type spc_t;
    type fusefs_t;
    type fusermount_exec_t;
    type unlabeled_t;
    type container_var_lib_t;
    attribute domain;
    attribute port_type;
    class file { execute execute_no_trans map open read create write getattr setattr ioctl lock append rename unlink };
    class dir { search read open create write getattr setattr ioctl lock add_name remove_name rmdir unlink };
    class lnk_file { read getattr open };
    class sock_file { create open read write getattr setattr ioctl lock append };
    class fifo_file { create open read write getattr setattr ioctl lock append };
    class tcp_socket { name_connect };
    class netlink_socket { create bind read write getattr setattr };
    class netlink_route_socket { create bind read write getattr setattr };
    class netlink_xfrm_socket { create bind read write getattr setattr };
    class netlink_generic_socket { create bind read write getattr setattr };
    class bpf { prog_load prog_run map_create map_read map_write };
    class perf_event { cpu kernel open read write tracepoint };
    class chr_file { create open read write getattr setattr ioctl };
    class blk_file { create open read write getattr setattr ioctl };
    class filesystem { relabelfrom relabelto mount getattr associate };
    class key { view read write search link setattr create };
    class system { syslog_read module_load };
    class process { setpgid signal transition dyntransition };
    class process2 { nnp_transition nosuid_transition };
    class capability { chown kill fowner fsetid mknod net_admin net_bind_service net_raw setfcap sys_resource dac_override sys_admin sys_ptrace sys_module };
    class capability2 { mac_override mac_admin };
    class tun_socket { create bind read write getattr setattr };
    class rawip_socket { create bind read write getattr setattr };
    class packet_socket { create bind read write getattr setattr };
    class socket { create bind read write getattr setattr };
    class service { start stop status enable disable reload };
}

# conmon: crio (init_t) execs the dnf-baked conmon (conmon_exec_t). No
# type_transition from init_t exists, so conmon stays in init_t and both
# execute and execute_no_trans are required (E2E: crio.service 203/EXEC).
allow init_t conmon_exec_t:file { execute execute_no_trans map open read getattr };

# systemd unit control: k8slab-merge (init_t) starts the k8s services with
# `systemctl start`; the unit files merged from the sysext overlay carry the
# unlabeled_t label, so systemd's unit-authorization check (class service)
# denies the start unless init_t may operate on unlabeled_t units.
allow init_t unlabeled_t:service { start stop status enable disable reload };

# Ports: apiserver -> etcd 2379 (unreserved), crio -> registry 443 (http).
allow init_t unreserved_port_t:tcp_socket name_connect;
allow init_t http_port_t:tcp_socket name_connect;

# kubelet: /dev/kmsg + kernel syslog_read.
allow init_t kmsg_device_t:chr_file { open read getattr };
allow init_t kernel_t:system syslog_read;

# kubelet device-plugins socket + crio/container storage under /var/lib/kubelet
# and /var/lib/containers (container_file_t). Note: on Fedora 44 the sock_file
# class carries only file-object permissions (bind/connect moved to the
# unix_stream_socket/unix_dgram_socket classes in modern kernels).
allow init_t container_file_t:sock_file { create open read write getattr setattr ioctl lock append };
allow init_t container_file_t:blk_file { create open read write getattr setattr ioctl };
allow init_t container_file_t:chr_file { create open read write getattr setattr ioctl };
# execute/execute_no_trans on the writable-layer files: crun's access check on
# the sandbox/container binary after the rootfs is relabeled with the sandbox
# MCS (container_file_t:s0:c<cats>; scratch proof from test boot 2).
allow init_t container_file_t:file { create open read write getattr setattr ioctl lock append rename unlink execute execute_no_trans map };
allow init_t container_file_t:dir { create open read write getattr setattr ioctl lock add_name remove_name rmdir search };
allow init_t container_file_t:lnk_file { create open read write getattr setattr ioctl lock append unlink };

# iptables: /run/xtables.lock (crio/kubelet iptables use).
allow init_t iptables_var_run_t:file { create open read write getattr setattr ioctl lock append };
allow init_t iptables_var_run_t:dir { create open read write getattr setattr ioctl lock add_name remove_name rmdir search };

# crio pinns: netns files under /run (ifconfig_var_run_t).
allow init_t ifconfig_var_run_t:file { create open read write getattr setattr ioctl lock append rename unlink };
allow init_t ifconfig_var_run_t:dir { create open read write getattr setattr ioctl lock add_name remove_name rmdir search };

# container runtime var dirs + conmon ctl fifo (/run/containers/storage,
# /run/crio, conmon fifo; E2E raw: overlay-false + mountpoints.lock creates).
allow init_t container_var_run_t:file { create open read write getattr setattr ioctl lock append rename unlink };
allow init_t container_var_run_t:dir { create open read write getattr setattr ioctl lock add_name remove_name rmdir search };
allow init_t container_var_run_t:fifo_file { create open read write getattr setattr ioctl lock append };

# Sandbox shm tmpfs (container_runtime_tmpfs_t): cleanup after pod teardown.
allow init_t container_runtime_tmpfs_t:dir { create open read write getattr setattr ioctl lock add_name remove_name rmdir search };
allow init_t container_runtime_tmpfs_t:file { create open read write getattr setattr ioctl lock append rename unlink };
allow init_t container_runtime_tmpfs_t:sock_file { create open read write getattr setattr ioctl lock append };
allow init_t container_runtime_tmpfs_t:fifo_file { create open read write getattr setattr ioctl lock append };

# Cilium CNI binary install on /run: the Cilium init containers run
# as init_t (this lab has no container-selinux type_transition) and must
# create/write the CNI bin dir /run/cni/bin on the tmpfs /run hierarchy after
# the CNI conf dir was relocated out of the read-only /opt.
allow init_t tmpfs_t:dir { search read write add_name create remove_name rmdir };
allow init_t tmpfs_t:file { create open read write getattr setattr rename unlink };

# Cilium CNI binary EXEC: the config-init container creates
# /run/cni (and /run/cni/bin) with the init_var_run_t label (matchpathcon
# expects var_run_t), and the mount-cgroup init container must then exec
# /run/cni/bin/cilium-mount — init_t is denied execute on init_var_run_t.
# Allow init_t to execute binaries under either /run label (var_run_t or the
# runtime-created init_var_run_t).
allow init_t var_run_t:dir { search read open getattr ioctl };
allow init_t var_run_t:file { execute execute_no_trans map open read getattr };
allow init_t init_var_run_t:dir { search read open getattr ioctl };
allow init_t init_var_run_t:file { execute execute_no_trans map open read getattr };

# Filesystem relabels for container mounts: crio shm tmpfs (tmpfs_t +
# container_file_t), crun devpts (devpts_t), and the overlay storage mount
# (fs_t — crio relabels the overlay fs at startup).
# Note: the filesystem class has relabelfrom/relabelto (no bare "relabel"
# permission in Fedora 44 policy).
allow init_t tmpfs_t:filesystem { relabelfrom relabelto mount getattr associate };
allow init_t container_file_t:filesystem { relabelfrom relabelto mount getattr associate };
allow init_t devpts_t:filesystem { relabelfrom relabelto mount getattr associate };
allow init_t fs_t:filesystem { relabelfrom relabelto };

# Container kernel keyring: crun (init_t)
# creates the container's keyring labeled container_t:s0:c<mcs>. Writing
# /proc/self/attr/keycreate checks init_t -> container_t:key create (kernel
# selinux_setprocattr LSM_ATTR_KEYCREATE; PROCESS setkeycreate is already in
# the base init_t grant — no AVC was logged for it), and the keyring is then
# searched/read by the runtime. Mirrors container-selinux's
# container_runtime_t -> container_t:key grant.
allow init_t container_t:key { view read write search link setattr create };

# Container process exec chain: crun (init_t)
# execs the sandbox/container binary from the read-only image layer
# (container_ro_file_t) and the process transitions to the container domain
# (container_t:s0:c<mcs>). Mirrors container-selinux's
# container_runtime_domain grants: can_exec(container_ro_file_t), entrypoint,
# and container_domain process transition (container.te lines ~129, 294, 319,
# 131). Without these the sandbox fails at "the path /pause exists but it is
# not executable: Operation not permitted" (avc: denied { execute } on
# container_ro_file_t).
allow init_t container_ro_file_t:file { execute execute_no_trans map open read getattr ioctl lock };
allow init_t container_ro_file_t:dir { search read open getattr ioctl lock };
allow init_t container_ro_file_t:lnk_file { read getattr open };
allow init_t container_ro_file_t:file entrypoint;
allow init_t container_t:process { transition dyntransition };
allow init_t container_t:process2 { nnp_transition nosuid_transition };

# Container -> runtime pipes: the container
# processes (container_t) write to the conmon pipe pairs owned by init_t —
# conmon runs in init_t in this lab (no type_transition installed), so
# container-selinux's container_domain <-> container_runtime_domain fifo rw
# grants do not apply. Without this the container runs but every log/stdin
# pipe write is denied (avc: container_t -> init_t:fifo_file { write }).
allow container_t init_t:fifo_file { read write getattr open ioctl append };

# fuse-overlayfs fallback (overlay unsupported over btrfs): init_t reads/execs
# the fusefs rootfs and runs fusermount3.
allow init_t fusefs_t:file { execute execute_no_trans map open read getattr ioctl lock };
allow init_t fusefs_t:dir { search read open getattr ioctl lock };
allow init_t fusefs_t:lnk_file { read getattr open };
allow init_t fusermount_exec_t:file { execute execute_no_trans map open read getattr };

# crio/conmon process management (E2E: process setpgid).
allow init_t init_t:process { setpgid signal };

# Cilium agent datapath: the cilium-agent main container runs as
# init_t and its route-reconciler creates netlink sockets (incl. xfrm) and
# loads/runs BPF programs; SELinux denied netlink_xfrm_socket { create } and
# bpf { prog_run } on a NetworkManager_t program, killing the agent.
allow init_t init_t:netlink_socket { create bind read write getattr setattr };
allow init_t init_t:netlink_route_socket { create bind read write getattr setattr };
allow init_t init_t:netlink_xfrm_socket { create bind read write getattr setattr };
allow init_t init_t:netlink_generic_socket { create bind read write getattr setattr };
allow init_t init_t:bpf { prog_load prog_run map_create map_read map_write };
allow init_t NetworkManager_t:bpf { prog_run };

# Cilium signal manager perf ring: the agent (init_t) creates a
# perf_event ring buffer for the signals map; SELinux denied perf_event open.
allow init_t init_t:perf_event { cpu kernel open read write tracepoint };

# kube-apiserver -> kubelet: apiserver (init_t) connects
# to the kubelet secure port 10250 (kubernetes_port_t) for logs/exec/top.
allow init_t kubernetes_port_t:tcp_socket { name_connect };

# ---------------------------------------------------------------------------
# spc_t domain for Cilium (correct SELinux configuration — plan
# TASK-B). Cilium's pods request seLinuxOptions type:spc_t in the committed
# manifests (the chart default; see cilium/install/04-workloads.yaml and
# container-selinux container.te:810-916). The base policy has no spc_t, so
# the pods fell back to init_t and every datapath operation needed a new
# init_t grant. Define spc_t here and wire the init_t -> spc_t transition so
# the committed requests take effect: spc_t is the container-selinux blessed
# highly-privileged domain, granted an unconfined-style permission set, which
# is exactly why container.te has zero per-perm perf_event/netlink rules for
# it (the Cilium datapath: perf ring PERF_TYPE_SOFTWARE+BPF_OUTPUT, bpf
# prog_load/prog_run/map ops, netlink xfrm/route, capabilities).
# ---------------------------------------------------------------------------
type spc_t;
domain_type(spc_t)
role system_r types spc_t;

# init_t (the container runtime in this lab) -> spc_t (container processes).
allow init_t spc_t:process { transition dyntransition };
allow init_t spc_t:process2 { nnp_transition nosuid_transition };
allow init_t { container_file_t container_ro_file_t unlabeled_t }:file { execute execute_no_trans map open read getattr ioctl lock };
allow spc_t { container_file_t container_ro_file_t unlabeled_t }:file entrypoint;
type_transition init_t container_file_t:process spc_t;
type_transition init_t container_ro_file_t:process spc_t;
allow spc_t { container_file_t container_ro_file_t }:file execmod;

# spc_t self grants (port of container.te spc section + Cilium datapath).
allow spc_t self:process execmem;
allow spc_t self:capability { chown kill fowner fsetid mknod net_admin net_bind_service net_raw setfcap sys_resource dac_override sys_admin sys_ptrace sys_module };
allow spc_t self:netlink_route_socket { create bind read write getattr setattr };
allow spc_t self:netlink_xfrm_socket { create bind read write getattr setattr };
allow spc_t self:netlink_generic_socket { create bind read write getattr setattr };
allow spc_t self:netlink_socket { create bind read write getattr setattr };
allow spc_t self:perf_event { cpu kernel open read write tracepoint };
allow spc_t self:key { view read write search link setattr create };
allow spc_t self:tun_socket { create bind read write getattr setattr };
allow spc_t self:rawip_socket { create bind read write getattr setattr };
allow spc_t self:packet_socket { create bind read write getattr setattr };
allow spc_t self:socket { create bind read write getattr setattr };
allow spc_t self:filesystem associate;
allow spc_t self:dir mounton;
allow spc_t self:file mounton;
allow spc_t { container_ro_file_t container_file_t }:system module_load;
allow spc_t unlabeled_t:key { view read write search link setattr create };
allow spc_t domain:bpf { map_create map_read map_write prog_load prog_run };
allow spc_t self:bpf { map_create map_read map_write prog_load prog_run };

# Unconfined-style catch-all for spc_t (the mechanism container-selinux uses
# so Cilium's full datapath works without per-perm grants). If the interface
# does not resolve in this module build, the explicit grants above cover the
# known denial catalog and the compiler error will say so.
unconfined_domain_noaudit(spc_t)
domain_transition_all(spc_t)

# kubelet/CRI-O port connects: kubelet (init_t) probes pod readiness
# on arbitrary labeled ports (http_cache_port_t 8080, intermapper_port_t 8181,
# ephemeral_port_t streaming) and was denied name_connect. Grant init_t tcp
# name_connect to EVERY port type (port_type attribute) — matching what the
# container runtime domain gets (corenet_tcp_connect_all_ports).
allow init_t port_type:tcp_socket name_connect;

# CRI-O short-name cache: cri-o resolves short image names by
# creating /var/cache/containers/short-name-aliases.conf.lock, which was
# denied { create } on the default var_t label. Bake the cache dir as
# container_var_lib_t (03-seal fcontext) and let init_t manage it.
allow init_t container_var_lib_t:dir { create open read write getattr setattr ioctl lock add_name remove_name rmdir search };
allow init_t container_var_lib_t:file { create open read write getattr setattr ioctl lock append rename unlink };
allow init_t container_var_lib_t:lnk_file { create open read write getattr setattr ioctl lock append unlink };
