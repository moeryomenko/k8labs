# Stage 1: base — system dependencies and kubectl
FROM docker.io/python:3.12-slim AS base

LABEL description="k8labs Ansible runner — community.crypto, community.general"

RUN apt-get update -qq \
 && apt-get install -y -qq --no-install-recommends openssh-client sshpass ca-certificates curl gnupg iproute2 rsync \
 && apt-get clean \
 && rm -rf /var/lib/apt/lists/*

# Download kubectl binary directly — the k8s apt repository is frequently
# unreachable from some networks and the apt install fails with timeout.
RUN KUBECTL_VERSION=v1.32.13 \
 && curl -fsSLo /usr/local/bin/kubectl \
    "https://dl.k8s.io/release/${KUBECTL_VERSION}/bin/linux/amd64/kubectl" \
 && chmod 755 /usr/local/bin/kubectl \
 && kubectl version --client

# Stage 2: ansible — Ansible, tools, and Cilium CLI
FROM base AS ansible

RUN pip install --no-cache-dir \
        ansible-core==2.18.3 \
        jmespath \
  && ansible-galaxy collection install \
        community.crypto==2.22.0 \
        community.general==9.5.0 \
        ansible.posix==1.6.2 \
  && rm -rf /root/.cache

# Install Cilium CLI for CNI installation
ARG CILIUM_CLI_VERSION=v0.19.6
RUN curl -sL "https://github.com/cilium/cilium-cli/releases/download/${CILIUM_CLI_VERSION}/cilium-linux-amd64.tar.gz" \
    | tar -xz -C /usr/local/bin/ cilium \
  && cilium version --client

WORKDIR /workspace
# No fixed entrypoint — caller specifies ansible, ansible-playbook, or ansible-galaxy
ENTRYPOINT []
